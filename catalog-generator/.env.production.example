# Plantilla de variables para Vercel. Los NEXT_PUBLIC_* son visibles en el navegador.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=id_ficticious.apps.googleusercontent.com
# Sustituye ambos dominios cuando el back-end tenga URL HTTPS.
NEXT_PUBLIC_CATALOG_API_URL=https://your-api-domain.example/api
CATALOG_API_URL=https://your-api-domain.example/api

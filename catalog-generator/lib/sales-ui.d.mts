export type RawSaleStatus = "DRAFT" | "CONFIRMED" | "DELIVERED" | "CANCELLED" | "RETURNED";
export type DisplayStatus = RawSaleStatus | "PARTIALLY_RETURNED";
export type SaleLine = { id: string; inventoryItemId: string; quantity: number; itemName: string; sku: string; unitPrice: string; unitDiscount: string; lineTotal: string; unitCost?: string | null };
export type SaleReturnLine = { id?: string; saleLineId: string; receivedQuantity: number; resellableQuantity: number; damagedQuantity: number };
export type SaleReturn = { id: string; reason: string; createdAt?: string; lines: SaleReturnLine[] };
export type Sale = {
  id: string; status: RawSaleStatus; version: number; currency: "COP"; subtotal: string; discountTotal: string; total: string;
  createdAt?: string; confirmedAt?: string | null; deliveredAt?: string | null; cancelledAt?: string | null; returnedAt?: string | null;
  customerId?: string | null; customerNameSnapshot?: string | null; customerPhoneSnapshot?: string | null; customerEmailSnapshot?: string | null;
  customerName?: string | null; customerPhone?: string | null; sourceOrderId?: string | null;
  customer?: { id?: string; fullName: string; phone?: string; archivedAt: string | null } | null;
  lines: SaleLine[]; returns: SaleReturn[];
};
export type DraftLine = { inventoryItemId: string; itemName: string; sku: string; unitPrice: string | null; stock: number | null; quantity: string; unitDiscount: string };
export type Failure = { title: string; detail: string; action: "reload" | "refreshPrices" | "retry" | "login" | null };
export type ReturnRows = Record<string, { resellable: string; damaged: string }>;
export const SALE_STATUSES: DisplayStatus[];
export const STATUS_LABELS: Record<DisplayStatus, string>;
export const STATUS_TONES: Record<DisplayStatus, string>;
export function formatCop(value: string | bigint): string;
export function parseMoneyInput(raw: unknown): string | null;
export function parseQuantityInput(raw: unknown): number | null;
export function parseSale(value: unknown): Sale;
export function parseSaleList(value: unknown): Sale[];
export function lineBalances(sale: Sale): Map<string, { sold: number; returned: number; pending: number }>;
export function hasPendingUnits(sale: Sale): boolean;
export function displayStatus(sale: Sale): DisplayStatus;
export function allowedActions(sale: Sale): { editDraft: boolean; confirm: boolean; confirmAndDeliver: boolean; deliver: boolean; cancel: boolean; registerReturn: boolean };
export function itemCount(sale: Sale): number;
export function buyerName(sale: Sale): string | null;
export function draftEstimate(lines: DraftLine[]): { rows: { lineTotal: string | null }[]; subtotal: string; discountTotal: string; total: string };
export function validateDraft(lines: DraftLine[]): string[];
export function buildReturn(sale: Sale, rows: ReturnRows, reason: string): { errors: string[]; lines: Omit<SaleReturnLine, "id">[]; reason: string };
export function intentFingerprint(action: string, saleId: string, body: unknown): string;
export function describeFailure(error: unknown): Failure;
export function insufficientItems(lines: SaleLine[], items: { id: string; stock: number }[]): { name: string; sku: string; available: number; requested: number }[];
export function formatDate(value: string | null | undefined): string | null;

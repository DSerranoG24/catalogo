# Public Google OAuth client ID; this is not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=id_ficticious.apps.googleusercontent.com
# Public read-only catalog endpoints. Use HTTPS in production.
NEXT_PUBLIC_CATALOG_API_URL=http://localhost:3000/api

# Server-only API URL used by the same-origin authenticated proxy.
CATALOG_API_URL=http://localhost:3000/api

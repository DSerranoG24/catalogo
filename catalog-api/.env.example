PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-server-side-secret-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CORS_ORIGINS=http://localhost:3001
# Public API base URL (including /api), used to build quotation links. HTTPS in production.
PUBLIC_API_URL=http://localhost:3000/api

# Account verification/recovery. Development must not send real email.
MAIL_MODE=log
BREVO_API_KEY=replace-with-a-private-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Your Brand
MAIL_FROM="Your Brand <verified-sender@example.com>"
# Frontend origin, never the API URL. HTTPS in production.
APP_PUBLIC_URL=http://localhost:3001
# Brevo sender must be verified. MAIL_FROM must match BREVO_SENDER_NAME <BREVO_SENDER_EMAIL>.
# Real sends require MAIL_MODE=brevo and NODE_ENV=production; log never contacts Brevo.

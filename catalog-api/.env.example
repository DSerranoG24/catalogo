PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-server-side-secret-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CORS_ORIGINS=http://localhost:3001
# Public API base URL (including /api), used to build quotation links. HTTPS in production.
PUBLIC_API_URL=http://localhost:3000/api

# Account verification/recovery. Development must not send real email.
MAIL_MODE=log
RESEND_API_KEY=replace-only-when-enabling-resend
MAIL_FROM=Vitrinaya <onboarding@resend.dev>
# Frontend origin, never the API URL. HTTPS in production.
APP_PUBLIC_URL=http://localhost:3001
# resend.dev cannot deliver to third parties; verify your own domain before enabling.
# vitrinaya983@gmail.com is the contact/reply-to, not a verified sending domain.

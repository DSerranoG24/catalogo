# Plantilla para Render; no contiene secretos reales. Render asigna PORT automáticamente.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-server-side-secret-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Sustituye por el dominio HTTPS real de Vercel.
CORS_ORIGINS=https://your-frontend-domain.example
# Public API base URL (including /api), used to build quotation links. Never derive it from Host.
PUBLIC_API_URL=https://your-api.onrender.com/api

# Account mail: keep log until explicitly enabling verified Brevo delivery.
MAIL_MODE=log
BREVO_API_KEY=replace-with-a-private-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Your Brand
MAIL_FROM="Your Brand <verified-sender@example.com>"
APP_PUBLIC_URL=https://your-frontend-domain.example
# Brevo sender must be verified; MAIL_FROM must match the structured sender exactly.
# Real sends require MAIL_MODE=brevo and NODE_ENV=production.

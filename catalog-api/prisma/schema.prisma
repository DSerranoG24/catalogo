  createdBy User @relation("ItemCompatibility_createdById", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("ItemCompatibility_updatedById", fields: [updatedById], references: [id], onDelete: Restrict)
  verifiedBy User? @relation("ItemCompatibility_verifiedById", fields: [verifiedById], references: [id], onDelete: Restrict)
}
model CompatibilityOperation {
  ownerId String
  operationId String
  resourceKind String
  resourceId String
  requestHash String @db.VarChar(64)
  responseSnapshot Json
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  events CompatibilityEvent[]
  @@id([ownerId, operationId])
  @@map("compatibility_operations")
}
model CompatibilityEvent {
  id String @id @default(uuid())

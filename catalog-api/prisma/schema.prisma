  @@unique([ownerId, operationId, entityKind, entityId])
  @@index([ownerId, entityKind, entityId, occurredAt, id])
  @@index([ownerId, setId, occurredAt, id])
  @@map("compatibility_events")
  actor User @relation("CompatibilityEvent_actorId", fields: [actorId], references: [id], onDelete: Restrict)

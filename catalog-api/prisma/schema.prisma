generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountActionPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum UserRole {
  USER
  ADMIN
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
  RETURNED
}

enum SaleOperationStatus {
  PREPARED
  SUCCEEDED
  REJECTED
  ABANDONED
}
enum SaleMovementRole {
  SALE_CONFIRMATION
  SALE_CANCELLATION
  SALE_RETURN_RESELLABLE
  SALE_RETURN_DAMAGED
}
enum InventoryPublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  emailVerifiedAt DateTime?
  sessionVersion Int @default(0)
  closedAt DateTime?
  role UserRole @default(USER)
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  catalogs Catalog[]
  customers Customer[]
  orderCustomerOperations OrderCustomerOperation[]
  inventoryItems InventoryItem[]
  inventoryBatches InventoryBatch[]
  inventoryWorkbook InventoryWorkbook?
  inventoryActions InventoryMovement[] @relation("InventoryActor")
  accountActionTokens AccountActionToken[]
  closureJob AccountClosureJob?
  sales Sale[]
  saleOperations SaleOperation[]
  saleReturns SaleReturn[]
  inventoryPublications InventoryPublication[]
  deviceBrand_createdById DeviceBrand[] @relation("DeviceBrand_createdById")
  deviceBrand_updatedById DeviceBrand[] @relation("DeviceBrand_updatedById")
  deviceModel_createdById DeviceModel[] @relation("DeviceModel_createdById")
  deviceModel_updatedById DeviceModel[] @relation("DeviceModel_updatedById")
  compatibilitySet_createdById CompatibilitySet[] @relation("CompatibilitySet_createdById")
  compatibilitySet_updatedById CompatibilitySet[] @relation("CompatibilitySet_updatedById")
  itemCompatibility_createdById ItemCompatibility[] @relation("ItemCompatibility_createdById")
  itemCompatibility_updatedById ItemCompatibility[] @relation("ItemCompatibility_updatedById")
  itemCompatibility_verifiedById ItemCompatibility[] @relation("ItemCompatibility_verifiedById")
  compatibilityEvent_actorId CompatibilityEvent[] @relation("CompatibilityEvent_actorId")
  deviceBrands DeviceBrand[]
  deviceModels DeviceModel[]
  compatibilitySets CompatibilitySet[]
  itemCompatibilities ItemCompatibility[]
  compatibilityOperations CompatibilityOperation[]
  compatibilityEvents CompatibilityEvent[]

  @@index([createdAt])

  @@map("users")
}

model Customer {
  id String @id @default(uuid())
  ownerId String
  fullName String @db.VarChar(160)
  phone String @db.VarChar(15)
  email String? @db.VarChar(254)
  address String? @db.VarChar(300)
  notes String? @db.VarChar(2000)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sales Sale[]
  orders Order[]
  orderOperations OrderCustomerOperation[]

  @@unique([id, ownerId])
  @@index([ownerId, phone])
  @@index([ownerId, archivedAt, createdAt, id])
  @@map("customers")
}

model InventoryWorkbook {
  userId String @id
  snapshot String @db.Text
  version Int @default(1)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  saves InventoryWorkbookSave[]
  @@map("inventory_workbooks")
}

model InventoryWorkbookSave {
  userId String
  operationId String
  hash String
  version Int
  createdAt DateTime @default(now())
  workbook InventoryWorkbook @relation(fields: [userId], references: [userId], onDelete: Restrict)
  @@id([userId, operationId])
  @@map("inventory_workbook_saves")
}

model InventoryItem {
  id String @id @default(uuid())
  userId String
  name String
  sku String
  stock Int @default(0)
  minimumStock Int @default(0)
  dataVersion Int @default(1)
  stockVersion Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
  commercialTerms ItemCommercialTerms?
  saleLines SaleLine[]
  images InventoryItemImage[]
  publications InventoryPublication[]
  catalogProducts Product[]
  compatibilitySet CompatibilitySet?

  @@unique([id, userId])
  @@unique([userId, sku])
  @@index([userId, createdAt])
  @@map("inventory_items")
}

model InventoryItemImage {
  id String @id @default(uuid())
  inventoryItemId String
  storagePath String
  alt String?
  position Int @default(0)
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  @@unique([inventoryItemId, storagePath])
  @@index([inventoryItemId, isPrimary, position])
}

model InventoryPublication {
  id String @id @default(uuid())
  userId String
  inventoryItemId String
  catalogId String
  productId String
  status InventoryPublicationStatus @default(DRAFT)
  titleOverride String?
  descriptionOverride String?
  priceOverride Int?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  item InventoryItem @relation(fields: [inventoryItemId, userId], references: [id, userId], onDelete: Restrict)
  catalog Catalog @relation(fields: [catalogId, userId], references: [id, userId], onDelete: Restrict)
  product Product @relation(fields: [productId, catalogId], references: [id, catalogId], onDelete: Restrict)
  @@unique([catalogId, inventoryItemId])
  @@unique([productId])
  @@unique([productId, catalogId])
  @@index([userId, status, updatedAt])
}

model InventoryMovement {
  id String @id @default(uuid())
  itemId String
  key String
  type String
  quantity Int
  previousStock Int
  resultingStock Int
  reason String
  delta Int @default(0)
  actorUserId String?
  origin String @default("MANUAL")
  batchId String?
  batchRowId String?
  batchOperationId String?
  saleId String?
  saleLineId String?
  saleMovementRole SaleMovementRole?
  createdAt DateTime @default(now())
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor User? @relation("InventoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  batchRow InventoryBatchRow? @relation(fields: [batchId, batchRowId], references: [batchId, rowId], onDelete: Restrict)
  sale Sale? @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleLine SaleLine? @relation(fields: [saleLineId], references: [id], onDelete: Restrict)

  @@unique([batchOperationId, itemId])
  @@unique([itemId, key])
  @@index([itemId, createdAt])
  @@index([saleId, saleLineId])
  @@index([saleId, saleMovementRole, createdAt])
  @@map("inventory_movements")
}

model Sale {
  id String @id @default(uuid())
  userId String
  /// Unique source order; migration must enforce at most one Sale per Order.
  sourceOrderId String? @unique
  status SaleStatus @default(DRAFT)
  version Int @default(1)
  currency String @default("COP")
  customerName String?
  customerPhone String?
  customerId String?
  customerNameSnapshot String? @db.VarChar(160)
  customerPhoneSnapshot String? @db.VarChar(24)
  customerEmailSnapshot String? @db.VarChar(254)
  customer Customer? @relation(fields: [customerId, userId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  subtotal BigInt @default(0)
  discountTotal BigInt @default(0)
  total BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  confirmedAt DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  returnedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceOrder Order? @relation("OrderToSale", fields: [sourceOrderId], references: [id], onDelete: Restrict)
  lines SaleLine[]
  operations SaleOperation[]
  returns SaleReturn[]
  movements InventoryMovement[]
  @@index([userId, createdAt, id])
  @@index([userId, status, createdAt])
  @@index([customerId, userId])
}

/// Migration SQL must add CHECK constraints: quantity > 0, unitPrice/unitCost/unitDiscount/lineTotal >= 0,
/// unitDiscount <= unitPrice, subtotal/discountTotal/total >= 0, discountTotal <= subtotal,
/// and subtotal - discountTotal = total.
model SaleLine {
  id String @id @default(uuid())
  saleId String
  inventoryItemId String
  quantity Int
  itemName String
  sku String
  unitPrice BigInt
  unitCost BigInt?
  unitDiscount BigInt @default(0)
  lineTotal BigInt
  commercialTermsVersion Int
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]
  returns SaleReturnLine[]
  @@unique([saleId, inventoryItemId])
  @@index([inventoryItemId])
}

model SaleOperation {
  id String @id @default(uuid())
  saleId String
  userId String
  type String
  status SaleOperationStatus @default(PREPARED)
  requestId String
  expectedSaleVersion Int?
  requestHash String
  responseSnapshot Json?
  createdAt DateTime @default(now())
  completedAt DateTime?
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, requestId])
  @@index([saleId, createdAt])
}

model SaleReturn {
  id String @id @default(uuid())
  saleId String
  userId String
  operationId String @unique
  reason String
  createdAt DateTime @default(now())
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  lines SaleReturnLine[]
  @@index([userId, saleId])
}

model SaleReturnLine {
  id String @id @default(uuid())
  returnId String
  saleLineId String
  receivedQuantity Int
  resellableQuantity Int
  damagedQuantity Int
  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  saleLine SaleLine @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  @@unique([returnId, saleLineId])
  /// Migration SQL: CHECK (receivedQuantity > 0), CHECK (resellableQuantity >= 0),
  /// CHECK (damagedQuantity >= 0), CHECK (resellableQuantity + damagedQuantity = receivedQuantity).
}

model ItemCommercialTerms {
  itemId String @id
  userId String
  currency String @default("COP")
  unitSalePrice BigInt
  referenceUnitCost BigInt?
  version Int @default(1)
  updatedAt DateTime @updatedAt
  item InventoryItem @relation(fields: [itemId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([itemId, userId])
  @@index([userId])
  @@map("item_commercial_terms")
}

model InventoryBatch {
  id String @id
  userId String
  source String
  status String @default("DRAFT")
  revision Int @default(1)
  previewRevision Int @default(0)
  totalRows Int
  reason String?
  inputHash String?
  planHash String?
  applyOperationId String? @unique
  previewExpiresAt DateTime?
  plan Json?
  receipt Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  rows InventoryBatchRow[]
  chunks InventoryBatchChunkReceipt[]

  @@index([userId, createdAt, id])
  @@map("inventory_batches")
}

model InventoryBatchRow {
  batchId String
  rowId String
  rowNumber Int
  revision Int @default(1)
  reservedItemId String @default(uuid())
  excluded Boolean @default(false)
  values Json
  batch InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]

  @@id([batchId, rowId])
  @@unique([batchId, rowNumber])
  @@map("inventory_batch_rows")
}

model InventoryBatchChunkReceipt {
  batchId String
  chunkId String
  hash String
  result Json
  batch InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@id([batchId, chunkId])
  @@map("inventory_batch_chunk_receipts")
}

model AccountActionToken {
  id String @id @default(uuid())
  userId String
  purpose AccountActionPurpose
  tokenHash String @unique
  emailAtIssue String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("account_action_tokens")
}

// Reservations survive token cleanup and process restarts. No recipient or token data.
model EmailDeliveryBudget {
  period String @id
  reserved Int @default(0)

  @@map("email_delivery_budgets")
}

model Catalog {
  id            String          @id @default(uuid())
  userId        String
  name          String
  slug          String
  description   String?
  logoUrl       String?
  nit           String?
  quotationTerms String?
  quotationCounter Int @default(0)
  publicId      String          @unique @default(uuid())
  whatsappPhone String?
  whatsappMessage String?
  phone         String?
  address       String?
  businessHours String?
  instagramUrl  String?
  facebookUrl   String?
  tiktokUrl     String?
  email         String?
  mapUrl        String?
  template      String          @default("EDITORIAL")
  themePreset   String?
  layoutPreset  String?
  active        Boolean         @default(true)
   archivedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories Category[]
  products   Product[]
  publications InventoryPublication[]
  orders     Order[]
    banners    CatalogBanner[]
  deletionMarkers OrderDeletionMarker[]

  @@unique([userId, slug])
  @@unique([id, userId])
  @@index([userId])
  @@map("catalogs")
}

model Category {
  id        String   @id @default(uuid())
  catalogId String
  name      String
  slug      String
  imageUrl  String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalog  Catalog   @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([catalogId, slug])
  @@index([catalogId])
  @@map("categories")
}

model Product {
  id           String    @id @default(uuid())
  catalogId    String
  categoryId   String?
  name         String
  slug         String
  description  String?
  brand        String?
  model        String?
  sku          String?
  price        Int
  salePrice    Int?
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  stock        Int       @default(0)
  active       Boolean   @default(true)
  featured     Boolean   @default(false)
  needsCompletion Boolean @default(false)
  specs        Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  catalog    Catalog         @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  reviews    ProductReview[]
  orderItems OrderItem[]
  inventoryItemId String?
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  publication InventoryPublication?

  @@unique([catalogId, slug])
  @@unique([catalogId, sku])
  @@unique([id, catalogId])
  @@index([catalogId])
  @@index([categoryId])
  @@map("products")
}

model CatalogBanner {
  id        String   @id @default(uuid())
  catalogId String
  imagePath String
  title     String
  subtitle  String?
  linkType  String
  linkValue String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, position])
  @@index([catalogId, position])
  @@map("catalog_banners")
}

model ProductReview {
  id          String       @id @default(uuid())
  productId   String
  displayName String?
  rating      Int
  comment     String
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status, createdAt])
  @@map("product_reviews")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Order {
  id                String      @id @default(uuid())
  catalogId         String
  idempotencyKey    String?
  quotationNumber   Int?
  quotationIssuedAt DateTime?
  quotationSellerSnapshot Json?
  quotationToken    String? @unique
  customerName      String
  customerPhone     String
  customerEmail     String?
  customerId        String?
  customerAddress   String?
  notes             String?
  customerConsentAt DateTime?
  customerConsentVersion String?
  anonymizedAt      DateTime?
  status            OrderStatus @default(PENDING)
  firstConfirmedAt  DateTime?
  total             Int
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  convertedSale Sale? @relation("OrderToSale")
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerOperations OrderCustomerOperation[]

  @@index([catalogId])
  @@unique([catalogId, idempotencyKey])
  @@unique([catalogId, quotationNumber])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderCustomerOperation {
  ownerId String
  operationId String
  orderId String
  customerId String
  associatedSaleId String?
  requestHash String
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId, ownerId], references: [id, ownerId], onDelete: Restrict)

  @@id([ownerId, operationId])
  @@index([orderId])
  @@map("order_customer_operations")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Int
  subtotal    Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderDeletionMarker {
  catalogId String
  keyHash String
  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  @@id([catalogId, keyHash])
  @@map("order_deletion_markers")
}

model AccountClosureJob {
  id String @id @default(uuid())
  userId String @unique
  phase String @default("PENDING")
  attempts Int @default(0)
  catalogIds String[]
  pendingPaths String[]
  scanQueue String[]
  scanOffset Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("account_closure_jobs")
}

model ProductImageCleanupTask {
  id String @id @default(uuid())
  path String
  bucket String @default("product-images")
  catalogId String
  state String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([bucket, path])
  @@index([state, nextAttemptAt])
  @@map("product_image_cleanup_tasks")
}


enum CompatibilityStatus {
  PENDING
  VERIFIED
  REJECTED
  WITHDRAWN
}
enum CompatibilityEvidenceType {
  SELLER_TEST
  MANUFACTURER_REFERENCE
  SUPPLIER_REFERENCE
  DOCUMENTED_REVIEW
}
model DeviceBrand {
  id String @id @default(uuid())
  ownerId String
  version Int @default(1)
  retiredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String
  updatedById String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  names DeviceBrandName[]
  models DeviceModel[]
  @@unique([id, ownerId])
  @@index([ownerId, id])
  @@map("device_brands")
  createdBy User @relation("DeviceBrand_createdById", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("DeviceBrand_updatedById", fields: [updatedById], references: [id], onDelete: Restrict)
}
model DeviceBrandName {
  id String @id @default(uuid())
  ownerId String
  brandId String
  label String @db.VarChar(100)
  normalizedKey String @db.VarChar(320)
  normalizationVersion Int @default(1)
  isCanonical Boolean @default(false)
  retiredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand DeviceBrand @relation(fields: [brandId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([ownerId, normalizedKey])
  @@index([ownerId, brandId, id])
  @@map("device_brand_names")
}
model DeviceModel {
  id String @id @default(uuid())
  ownerId String
  brandId String
  manufacturerCode String? @db.VarChar(100)
  manufacturerCodeKey String? @db.VarChar(320)
  version Int @default(1)
  retiredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String
  updatedById String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  brand DeviceBrand @relation(fields: [brandId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  names DeviceModelName[]
  compatibilities ItemCompatibility[]
  @@unique([id, ownerId])
  @@unique([id, ownerId, brandId])
  @@unique([ownerId, brandId, manufacturerCodeKey])
  @@index([ownerId, brandId, id])
  @@map("device_models")
  createdBy User @relation("DeviceModel_createdById", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("DeviceModel_updatedById", fields: [updatedById], references: [id], onDelete: Restrict)
}
model DeviceModelName {
  id String @id @default(uuid())
  ownerId String
  brandId String
  modelId String
  label String @db.VarChar(160)
  normalizedKey String @db.VarChar(320)
  normalizationVersion Int @default(1)
  isCanonical Boolean @default(false)
  retiredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  model DeviceModel @relation(fields: [modelId, ownerId, brandId], references: [id, ownerId, brandId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([ownerId, brandId, normalizedKey])
  @@index([ownerId, modelId, id])
  @@map("device_model_names")
}
model CompatibilitySet {
  id String @id @default(uuid())
  ownerId String
  kind String @default("INVENTORY_ITEM")
  inventoryItemId String @unique
  version Int @default(1)
  retiredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String
  updatedById String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  item InventoryItem @relation(fields: [inventoryItemId, ownerId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  compatibilities ItemCompatibility[]
  events CompatibilityEvent[]
  @@unique([id, ownerId])
  @@unique([inventoryItemId, ownerId])
  @@index([ownerId, inventoryItemId])
  @@map("compatibility_sets")
  createdBy User @relation("CompatibilitySet_createdById", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("CompatibilitySet_updatedById", fields: [updatedById], references: [id], onDelete: Restrict)
}
model ItemCompatibility {
  id String @id @default(uuid())
  ownerId String
  setId String
  modelId String
  status CompatibilityStatus @default(PENDING)
  version Int @default(1)
  evidenceType CompatibilityEvidenceType?
  evidenceReference String? @db.VarChar(500)
  note String? @db.VarChar(1000)
  reviewReason String? @db.VarChar(500)
  verifiedById String?
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String
  updatedById String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  set CompatibilitySet @relation(fields: [setId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  model DeviceModel @relation(fields: [modelId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([id, ownerId])

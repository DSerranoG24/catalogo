// ---- Gastos (docs/expenses-contract.md v1.2) ----
// CHECK constraints and triggers live in migration 20261125000000_operating_expenses (Prisma 6 does not represent them).

enum ExpenseStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  SKIPPED
  VOIDED
}

enum ExpenseSource {
  MANUAL
  RECURRING
}

enum ExpensePaymentMethod {
  CASH
  NEQUI
  DAVIPLATA
  BANK_TRANSFER
  CARD
  OTHER
}

enum RecurringExpenseStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum ExpenseFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model ExpenseCategory {
  id            String                     @id @default(uuid())
  ownerId       String
  name          String                     @db.VarChar(60)
  normalizedKey String                     @db.VarChar(240)
  seedKey       String?                    @db.VarChar(40)
  position      Int                        @default(0)
  archivedAt    DateTime?
  version       Int                        @default(1)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  owner         User                       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  expenses      Expense[]
  scheduledPayments ScheduledExpensePayment[]
  templates     RecurringExpenseTemplate[]

  @@unique([id, ownerId])
  @@unique([ownerId, normalizedKey])
  @@unique([ownerId, seedKey])
  @@index([ownerId, position, id])
  @@map("expense_categories")
}

/// F1b. Created in F1a so the expense FK exists; no endpoints or UI yet.
model RecurringExpenseTemplate {
  id                String                 @id @default(uuid())
  ownerId           String
  status            RecurringExpenseStatus @default(ACTIVE)
  description       String                 @db.VarChar(300)
  categoryId        String
  paymentMethod     ExpensePaymentMethod
  paymentMethodNote String?                @db.VarChar(80)
  supplierName      String?                @db.VarChar(160)
  estimatedAmount   BigInt?
  frequency         ExpenseFrequency
  interval          Int
  anchorDate        DateTime               @db.Date
  endDate           DateTime?              @db.Date
  generatedThrough  DateTime?              @db.Date
  version           Int                    @default(1)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  endedAt           DateTime?
  owner             User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category          ExpenseCategory        @relation(fields: [categoryId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  expenses          Expense[]
  scheduledPayments ScheduledExpensePayment[]

  @@unique([id, ownerId])
  @@index([ownerId, status])
  @@map("recurring_expense_templates")
}

model Expense {
  id                   String                    @id @default(uuid())
  ownerId              String
  status               ExpenseStatus             @default(CONFIRMED)
  source               ExpenseSource             @default(MANUAL)
  templateId           String?
  occurrenceDate       DateTime?                 @db.Date
  expenseDate          DateTime                  @db.Date
  amount               BigInt?
  suggestedAmount      BigInt?
  currency             String                    @default("COP") @db.VarChar(3)
  taxMode              String                    @default("NOT_MANAGED") @db.VarChar(20)
  categoryId           String
  categoryNameSnapshot String?                   @db.VarChar(60)
  paymentMethod        ExpensePaymentMethod
  paymentMethodNote    String?                   @db.VarChar(80)
  paymentReference     String?                   @db.VarChar(100)
  description          String                    @db.VarChar(300)
  supplierName         String?                   @db.VarChar(160)
  replacesExpenseId    String?                   @unique
  recordedAt           DateTime                  @default(now())
  confirmedAt          DateTime?
  skippedAt            DateTime?
  skipReason           String?                   @db.VarChar(300)
  voidedAt             DateTime?
  voidReason           String?                   @db.VarChar(300)
  version              Int                       @default(1)
  updatedAt            DateTime                  @updatedAt
  owner                User                      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category             ExpenseCategory           @relation(fields: [categoryId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  template             RecurringExpenseTemplate? @relation(fields: [templateId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  replaces             Expense?                  @relation("ExpenseReplacement", fields: [replacesExpenseId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  replacedBy           Expense[]                 @relation("ExpenseReplacement")
  /// F1b: set on insert when the expense pays a scheduled payment; immutable (expense_transition_guard).
  scheduledPaymentId   String?
  scheduledPayment     ScheduledExpensePayment?  @relation("ExpenseScheduledPayment", fields: [scheduledPaymentId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  paidScheduledPayments ScheduledExpensePayment[] @relation("ScheduledPaymentPaidExpense")

  @@unique([id, ownerId])
  @@unique([templateId, occurrenceDate])
  @@index([ownerId, status, expenseDate, id])
  @@index([ownerId, categoryId, expenseDate])
  @@index([ownerId, paymentMethod, expenseDate])
  @@index([ownerId, status, templateId])
  @@index([ownerId, scheduledPaymentId])
  @@map("expenses")
}

/// Terminal receipt of a successful mutation. requestHash excludes requestId (same rule as Ventas v2.1).
model ExpenseOperation {
  ownerId          String
  operationId      String
  requestId        String
  kind             String         @db.VarChar(40)
  resourceId       String
  requestHash      String         @db.VarChar(64)
  responseSnapshot Json
  createdAt        DateTime       @default(now())
  owner            User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  events           ExpenseEvent[]

  @@id([ownerId, operationId])
  @@unique([ownerId, requestId])
  @@map("expense_operations")
}

model ExpenseEvent {
  id          String            @id @default(uuid())
  ownerId     String
  operationId String?
  entityKind  String            @db.VarChar(20)
  entityId    String
  eventType   String            @db.VarChar(40)
  before      Json?
  after       Json
  occurredAt  DateTime          @default(now())
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  operation   ExpenseOperation? @relation(fields: [ownerId, operationId], references: [ownerId, operationId], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerId, entityKind, entityId, occurredAt, id])
  @@map("expense_events")
}

/// F1b (docs/expenses-f1b-contract.md). CHECK constraints, the partial unique index on (templateId, occurrenceDate)
/// and the transition/coherence triggers live in migration 20261126000000_scheduled_expense_payments.
enum ScheduledExpenseStatus {
  PENDING
  PAID
  CANCELLED
}

/// A payment to make: an occurrence of a fixed expense (templateId set) or a one-off (templateId null).
/// Never counts in expense totals; paying it creates a CONFIRMED expense linked by expenses.scheduledPaymentId.
model ScheduledExpensePayment {
  id                  String                    @id @default(uuid())
  ownerId             String
  status              ScheduledExpenseStatus    @default(PENDING)
  templateId          String?
  occurrenceDate      DateTime?                 @db.Date
  dueDate             DateTime                  @db.Date
  plannedAmount       BigInt?
  description         String                    @db.VarChar(300)
  categoryId          String
  categoryNameSnapshot String?                  @db.VarChar(60)
  paymentMethod       ExpensePaymentMethod
  paymentMethodNote   String?                   @db.VarChar(80)
  supplierName        String?                   @db.VarChar(160)
  customizedAt        DateTime?
  paidExpenseId       String?
  paidAt              DateTime?
  cancelledAt         DateTime?
  cancelReason        String?                   @db.VarChar(300)
  version             Int                       @default(1)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  owner               User                      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  template            RecurringExpenseTemplate? @relation(fields: [templateId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  category            ExpenseCategory           @relation(fields: [categoryId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  paidExpense         Expense?                  @relation("ScheduledPaymentPaidExpense", fields: [paidExpenseId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  expenses            Expense[]                 @relation("ExpenseScheduledPayment")

  @@unique([id, ownerId])
  @@index([ownerId, status, dueDate])
  @@index([ownerId, templateId, dueDate])
  @@map("scheduled_expense_payments")
}

// ---- F2a: payments of a sale (docs/sales-payments-cartera-contract.md). Migration 20261126100000_sale_payments_ledger. ----

enum SalePaymentMode {
  TRACKED
  LEGACY
}

/// Real payment methods. Fiado is not a method: it is the unpaid balance.
enum SalePaymentMethod {
  CASH
  NEQUI
  DAVIPLATA
  BANK_TRANSFER
  CARD
  OTHER
}

/// RECEIPT_ALLOCATION (abonos) is added in F2-1.
enum SalePaymentEntryKind {
  PAYMENT
  CREDIT_USE
  EXCESS_TO_CREDIT
  SALE_REFUND
  REVERSAL
}

enum CustomerCreditEntryKind {
  FROM_SALE
  USED
  REFUND
  REVERSAL
}

/// Append-only money ledger of one sale. UPDATE, DELETE and TRUNCATE are rejected by triggers; a REVERSAL undoes an entry.
model SalePaymentEntry {
  id              String               @id @default(uuid())
  ownerId         String
  saleId          String
  kind            SalePaymentEntryKind
  amount          BigInt
  method          SalePaymentMethod?
  methodNote      String?              @db.VarChar(80)
  reference       String?              @db.VarChar(100)
  /// Cash handed over by the customer (CASH payments only). Informative: change = cashReceived - amount, never stored.
  cashReceived    BigInt?
  creditEntryId   String?
  reversesEntryId String?              @unique
  reason          String?              @db.VarChar(300)
  operationId     String
  /// Ordinal of the entry inside its operation and sale: a repeated operation cannot write it twice.
  position        Int
  createdAt       DateTime             @default(now())
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sale            Sale                 @relation(fields: [saleId, ownerId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  creditEntry     CustomerCreditEntry? @relation(fields: [creditEntryId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  reverses        SalePaymentEntry?    @relation("SalePaymentReversal", fields: [reversesEntryId, saleId], references: [id, saleId], onDelete: Restrict, onUpdate: Restrict)
  reversedBy      SalePaymentEntry[]   @relation("SalePaymentReversal")

  @@unique([id, ownerId])
  @@unique([id, saleId])
  @@unique([ownerId, operationId, saleId, position])
  @@index([ownerId, saleId, createdAt])
  @@index([creditEntryId, ownerId])
  @@map("sale_payment_entries")
}

/// Append-only ledger of a customer's credit balance (saldo a favor). Balance = signed sum, never negative.
model CustomerCreditEntry {
  id              String                  @id @default(uuid())
  ownerId         String
  customerId      String
  kind            CustomerCreditEntryKind
  amount          BigInt
  saleId          String?
  method          SalePaymentMethod?
  methodNote      String?                 @db.VarChar(80)
  reference       String?                 @db.VarChar(100)
  reversesEntryId String?                 @unique
  reason          String?                 @db.VarChar(300)
  operationId     String
  position        Int
  createdAt       DateTime                @default(now())
  owner           User                    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  customer        Customer                @relation(fields: [customerId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  sale            Sale?                   @relation(fields: [saleId, ownerId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  reverses        CustomerCreditEntry?    @relation("CustomerCreditReversal", fields: [reversesEntryId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  reversedBy      CustomerCreditEntry[]   @relation("CustomerCreditReversal")
  saleEntries     SalePaymentEntry[]

  @@unique([id, ownerId])
  @@unique([id, customerId])
  @@unique([ownerId, operationId, position])
  @@index([ownerId, customerId, createdAt])
  @@index([saleId, ownerId])
  @@map("customer_credit_entries")
}

/// Idempotency receipts of money operations that are not a single "SaleOperation" (anticipos, voids, refunds; abonos in F2).
model SaleMoneyOperation {
  ownerId          String
  operationId      String
  requestId        String
  kind             String   @db.VarChar(40)
  resourceId       String
  requestHash      String   @db.VarChar(64)
  responseSnapshot Json
  createdAt        DateTime @default(now())
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@id([ownerId, operationId])
  @@unique([ownerId, requestId])
  @@map("sale_money_operations")
}

/// Business-level receivable settings. No row = defaults (a read never creates it).
model ReceivableSettings {
  ownerId         String   @id
  defaultTermDays Int      @default(30)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@map("receivable_settings")
}
